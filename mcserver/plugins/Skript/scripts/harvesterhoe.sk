command /getharvesterhoe:
    permission: op
    trigger:
        give 1 diamond hoe named "&aHarvester Hoe" to player
        enchant player's tool with unbreaking 3
        enchant player's tool with fortune 3
        set lore of player's tool to "&a&oFarming Tool||&7Harvests a 3x3 patch of crops."
        send "&a[Special Items] You received the Harvester Hoe!"

on break:
    if name of player's tool is "&aHarvester Hoe":
        # Broadened block checks to support older Eaglercraft Skript IDs
        if event-block is wheat plant or carrot plant or potato plant or nether wart plant:
            
            # Prevent loop crashes
            if {_farming::%player's uuid%} is true:
                stop
            set {_farming::%player's uuid%} to true
            set {_b} to event-block
            
            # Harvest the 8 surrounding blocks safely
            break block 1 north of {_b} naturally
            break block 1 northeast of {_b} naturally
            break block 1 northwest of {_b} naturally
            break block 1 east of {_b} naturally
            break block 1 west of {_b} naturally
            break block 1 south of {_b} naturally
            break block 1 southeast of {_b} naturally
            break block 1 southwest of {_b} naturally
            
            clear {_farming::%player's uuid%}
