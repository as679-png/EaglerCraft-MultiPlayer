command /getshockwavebow [<player>]:
    permission: op
    trigger:
        set {_target} to player
        if arg-1 is set:
            set {_target} to arg-1
            
        give 1 bow named "&6&lSHOCKWAVE BOW" to {_target}
        
        # 1.8.8 Custom Skin Durability Hook
        set durability of {_target}'s tool to 5
        
        enchant {_target}'s tool with power 5
        enchant {_target}'s tool with unbreaking 3
        enchant {_target}'s tool with infinity 1
        set lore of {_target}'s tool to "&7&m--------------------------||&7Type: &e&lCustom Ranged Skin||&7Rarity: &5&lMYTHIC||&f||&6&l[SPECIAL ABILITY]||&7» Destroys ALL protection zones!||&7» &b&lINFINITE DURABILITY||&7&m--------------------------"

on projectile hit:
    if projectile is an arrow:
        if shooter is a player:
            if name of shooter's tool is "&6&lSHOCKWAVE BOW":
                set {_b} to location of event-block
                create a safe explosion of force 0 at {_b}
                
                # Manual crater grid
                break block at {_b} naturally
                break block 1 north of {_b} naturally
                break block 1 south of {_b} naturally
                break block 1 east of {_b} naturally
                break block 1 west of {_b} naturally
                break block 1 northeast of {_b} naturally
                break block 1 northwest of {_b} naturally
                break block 1 southeast of {_b} naturally
                break block 1 southwest of {_b} naturally
                break block 1 above {_b} naturally
                break block 1 north of block 1 above {_b} naturally
                break block 1 south of block 1 above {_b} naturally
                break block 1 east of block 1 above {_b} naturally
                break block 1 west of block 1 above {_b} naturally
                break block 1 below {_b} naturally
                break block 1 north of block 1 below {_b} naturally
                break block 1 south of block 1 below {_b} naturally
                break block 1 east of block 1 below {_b} naturally
                break block 1 west of block 1 below {_b} naturally
                delete projectile

# =========================================================================
# INFINITE DURABILITY SYSTEM (Locks the custom skin texture)
# =========================================================================
on item damage:
    # Checks if the item being damaged is your custom Shockwave Bow
    if name of player's tool is "&6&lSHOCKWAVE BOW":
        cancel event
